{
  "name": "ky-dao",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "wrangler dev --config server/wrangler.jsonc",
    "build": "tsc --noEmit -p . && tsc --noEmit -p server && vite build",
    "typecheck:server": "tsc --noEmit -p server",
    "deploy:server": "wrangler deploy --config server/wrangler.jsonc",
    "preview": "vite preview",
    "test": "vitest run tests",
    "bench:bots": "vitest run scripts/selfplay.test.ts --dir scripts",
    "bench:hint": "vitest run scripts/hint-strength.test.ts --dir scripts",
    "validate": "vitest run tests/data-",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wrangler": "^4.158.0"
  }
}
